# AI advisor (optional). Leave LLM_PROVIDER unset to run rules-only.
# "ollama" keeps message text on your own host; "claude" sends it to Anthropic.
LLM_PROVIDER=

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Claude (LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Abort the advisor call after this many ms and fall back to rules-only.
LLM_TIMEOUT_MS=30000
