# AI advisor (optional). Leave LLM_PROVIDER unset to run rules-only.
# "ollama" keeps message text on your own host; "claude" sends it to Anthropic.
LLM_PROVIDER=

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Claude (LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Abort the advisor call after this many ms and fall back to rules-only.
LLM_TIMEOUT_MS=30000

# Rate limits for /api/verify (in memory, per server process).
# Checks per IP per minute; over this returns 429.
RATE_LIMIT_PER_MINUTE=10
# AI calls per IP and in total per day; over these, checks run on rules only.
AI_LIMIT_PER_IP_PER_DAY=20
AI_LIMIT_PER_DAY=500
